# GEMINI_API_KEY: Optional for enhanced generative descriptions.
# Automatically falls back to deterministic local AI scoring if not provided.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# AMAZON AFFILIATE CONFIGURATION (Optional - App runs 100% in Demo Mode)
# Target Marketplaces: www.amazon.in & www.amazon.com
# StoreID / Partner Tags used for affiliate link creation
AMAZON_PARTNER_TAG=digitalrani01-21
AMAZON_COM_PARTNER_TAG=digital04b9-20

# Amazon Creators API OAuth 2.0 Credentials (Optional)
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_CREDENTIAL_VERSION=2.1

# HERMES AGENT API KEY (Optional - runs in open demo mode if omitted)
HERMES_API_KEY=
