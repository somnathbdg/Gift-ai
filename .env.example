# PORT: Application port (defaults to 3000; Render provides this automatically)
PORT=3000

# ADMIN_PASSWORD: Required to access the Admin Console and execute catalog operations.
# Configure a strong, secret password in your Render dashboard environment variables.
ADMIN_PASSWORD=

# HERMES_API_KEY: Secret key required for automated Hermes Agent REST API endpoints.
# If left blank, Hermes Agent API is locked and safely disabled.
HERMES_API_KEY=

# GEMINI_API_KEY: Optional. Google Gemini API key for AI gift recommendations & message studio.
# If not provided, the platform automatically runs high-quality deterministic matching & templates.
GEMINI_API_KEY=

# AMAZON AFFILIATE CONFIGURATION
# Partner tags attached to outbound product links for commission attribution
AMAZON_PARTNER_TAG=digitalrani01-21
AMAZON_COM_PARTNER_TAG=digital04b9-20

# Amazon Creators API OAuth 2.0 Credentials (Optional)
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_CREDENTIAL_VERSION=2.1
